# Copy this file to .env and adjust.
PORT=5000

# Frontend origin(s) allowed to call the API. Comma-separate several.
# In development (NODE_ENV not "production") every origin is allowed.
ALLOWED_ORIGIN=http://localhost:5500

# "production" on Render, anything else locally.
NODE_ENV=development

# How long JSON file reads stay cached in memory (milliseconds). 0 = cache forever.
CACHE_TTL_MS=300000
